{#- The run gallery. Context: see tsbench.report.gallery.context(), whole as `ctx`; the body is the macro of
gallery_parts.html.j2, which the full report uses too. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "gallery_parts.html.j2" import gallery_body %}
{% block css %}body{max-width:1500px}
{% include "gallery.css" %}{% endblock %}
{% block content %}
<div class="gallery"><header class="top"><h1>Run gallery</h1>
<p class="sub">{{ plural(counts.runs, "run") }} from {{ plural(n_sets, "run set") }}, {{ plural(counts.figures, "figure") }}, {{ plural(counts.images, "image") }} made by the models, {{ plural(counts.runs_with_code, "run") }} with code. View only: nothing here was executed. Under every card stands the command that repeats the run.</p></header>
</div>
{{ gallery_body(ctx) }}
{% endblock %}
{% block scripts %}
<script>{% include "gallery.js" %}</script>
{% endblock %}
