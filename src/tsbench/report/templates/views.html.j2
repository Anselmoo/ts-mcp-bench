{#- The page of one run. Context: title, rid, index_href, raw_href, facts [(label, text)], flags, prompt, system, argv
(text or none), images, image_match, answer, parsed (text or none), has_result, n_calls, calls [{n, name, state, input,
result}], run_rows [(label, text)], score (none, or {good, rows [(label, text)]}). Texts are cut to length in Python. -#}
{% extends "views_page.html.j2" %}
{% from "views_macros.html.j2" import pre, images as images_block %}
{% block main %}
<p><a href="{{ index_href }}">index</a> &middot; <a href="{{ raw_href }}">raw transcript</a></p>
<h1>{{ rid }}</h1>
<section><table>
{% for label, value in facts %}
<tr><th>{{ label }}</th><td>{{ value }}</td></tr>
{% endfor %}
</table>
{% if flags %}
<p>{% for f in flags %}<span class="tag bad">{{ f }}</span>{% endfor %}</p>
{% endif %}
</section>
<h2>Input</h2><section><strong>User prompt</strong>
{% if prompt %}{{ pre(prompt) }}{% else %}<p class="muted">not available (no plan, task not found)</p>{% endif %}
<strong>System prompt</strong>
{% if system %}{{ pre(system) }}{% else %}<p class="muted">not available</p>{% endif %}
{% if argv is not none %}
<strong>argv template</strong>{{ pre(argv) }}
{% endif %}
</section>
{% if images %}
<h2>Image</h2><section>{{ images_block(images, image_match) }}</section>
{% endif %}
<h2>Final answer</h2><section>
{% if answer %}{{ pre(answer) }}{% else %}<p class="muted">no answer text</p>{% endif %}
{% if parsed is not none %}
<strong>parsed JSON line</strong>{{ pre(parsed) }}
{% elif has_result %}
<p class="bad">no parseable answer line</p>
{% endif %}
</section>
<h2>Tool calls ({{ n_calls }})</h2>
{% for c in calls %}
<section><strong>{{ c.n }}. {{ c.name }}</strong> {% if c.state == "error" %}<span class="bad">error</span>{% elif c.state == "no result" %}<span class="muted">no result</span>{% endif %}<div class="muted">input</div>{{ pre(c.input) }}<div class="muted">result</div>{{ pre(c.result) }}</section>
{% else %}
<section><p class="muted">none</p></section>
{% endfor %}
<h2>Run</h2><section><table>
{% for label, value in run_rows %}
<tr><th>{{ label }}</th><td>{{ value }}</td></tr>
{% endfor %}
</table></section>
<h2>Score</h2><section>
{% if score is none %}
<p class="muted">no scores.csv row (run <code>tsbench score</code>)</p>
{% else %}
<p class="{{ 'ok' if score.good else 'bad' }}">{{ 'correct' if score.good else 'incorrect' }}</p><div class="table-wrap"><table>
{% for label, value in score.rows %}
<tr><th>{{ label }}</th><td>{{ value }}</td></tr>
{% endfor %}
</table></div>
{% endif %}
</section>
{% endblock %}
