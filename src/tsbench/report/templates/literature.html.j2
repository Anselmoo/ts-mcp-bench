{#- The literature page: fit results against the published values. Context: see tsbench.report.literature.context(),
whole as `ctx`; the sections are the macros of literature_parts.html.j2, which the full report uses too. The
sections go from the accuracy and the systems to the method box at the end. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "literature_parts.html.j2" import lit_facts, lit_accuracy, lit_parity, lit_relerr, lit_systems, lit_exclusions, lit_methods %}
{% block css %}{% include "literature.css" %}{% endblock %}
{% block content %}
<header><h1>{{ title }}</h1>
<p class="stamp">Pilot runs, not preregistered</p>
<p class="meta">Date: {{ date }}</p>
{{ lit_facts(ctx) }}
</header>
{{ lit_accuracy(ctx) }}
{{ lit_parity(ctx) }}
{{ lit_relerr(ctx) }}
{{ lit_systems(ctx) }}
{{ lit_exclusions(ctx) }}
{{ lit_methods(ctx) }}
{% endblock %}
{% block scripts %}
<script id="lit-draw">{% include "literature.js" %}</script>
{% endblock %}
