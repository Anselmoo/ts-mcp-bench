{#- The one-page summary of a functional test. Context: see tsbench.report.summary.context(). -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "_macros.html.j2" import status_chip, link %}
{% block css %}
.flow{display:flex;flex-wrap:wrap;align-items:stretch;gap:8px;margin:12px 0 20px;padding:0;list-style:none}
.flow li{--accent:var(--rule);flex:1 1 150px;max-width:210px;padding:10px 12px;background:var(--card);border:1px solid var(--line);
border-top:3px solid var(--accent);border-radius:var(--radius-callout)}
.flow li.ok{--accent:var(--ok)}.flow li.fail{--accent:var(--bad);background:var(--bad-bg)}.flow li.na{--accent:var(--warn)}
.flow li b{display:block;font-size:.85rem}.flow li span{font-size:.78rem;color:var(--ink-muted)}
.flow li.arrow{flex:0 0 auto;border:0;padding:8px 0;background:none;color:var(--rule);align-self:center}
code{word-break:break-all}
{% endblock %}
{% macro links(items) %}{% for item in items %}{% if not loop.first %} · {% endif %}{{ link(item) }}{% endfor %}{% endmacro %}
{% block content %}
<h1>Functional test of tsbench</h1>
<p class="stamp">{{ mode }} · {{ when }}</p>
<p class="verdict {{ verdict.cls }}">{{ verdict.text }}</p>
{% if overview %}
<p>Time line, data flow between the steps and the runs on one page: {{ link(overview) }}.</p>
{% endif %}
<p>The whole pipeline ran once, end to end: task set → sandbox probe → plan → run → score → figures → report pages.
{%- if probe %} Sandbox probe verdict: <b>{{ probe }}</b>.{% endif %}</p>

<h2>Flow</h2>
<ol class="flow">
{% for s in steps %}
{% if not loop.first %}
<li class="arrow" aria-hidden="true">→</li>
{% endif %}
<li class="{{ s.state }}"><b>{{ s.name }}</b><span>{{ s.word }}</span></li>
{% endfor %}
</ol>

<h2>Steps</h2>
<div class="scroll"><table>
<thead><tr><th>Step</th><th>Result</th><th>Command</th><th>Outputs</th></tr></thead>
<tbody>
{% for s in steps %}
<tr><td><b>{{ s.name }}</b><br><small>{{ s.purpose }}</small></td>
<td>{{ status_chip(s.chip, s.chip_text) }}</td><td><code>{{ s.command }}</code></td>
<td>{% if s.outputs %}{{ links(s.outputs) }}{% else %}<span class="muted">—</span>{% endif %}<br><small>{{ link(s.log) }}</small></td></tr>
{% endfor %}
</tbody>
</table></div>
{% if scores %}

<h2>Runs and verdicts</h2>
<p>From <code>runs/scores.csv</code>. The numbers test the machinery, not the model: they are not benchmark results.</p>
<div class="scroll"><table>
<thead><tr><th>Model</th><th>Cond.</th><th>Task</th><th>Correct</th><th>Evaluable</th><th>Category</th></tr></thead>
<tbody>
{% for r in scores %}
<tr><td>{{ r.model }}</td><td>{{ r.condition }}</td><td>{{ r.task_id }}</td><td>{{ r.correct }}</td><td>{{ r.evaluable }}</td><td>{{ r.category }}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% endif %}

<h2>Stored inputs</h2>
<p>{{ links(inputs) }}</p>
<p><code>runs/inputs/commands.sh</code> re-runs every model call of this test; it names the key variables but never
holds a key value.</p>

<h2>Pages and figures</h2>
<p>{{ links(pages) }}</p>
{% if provenance %}

<h2>Provenance</h2>
<p>Which function each step ran and which file it read and wrote, with the sha256 of every file version, and whether
the files of the steps fit together: {{ link(provenance) }}.</p>
{% endif %}
{% endblock %}
