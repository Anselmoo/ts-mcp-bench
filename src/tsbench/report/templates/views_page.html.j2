{#- The frame of the per-run views, the index and the overview. Context: `title`; the child fills the block `main`.
The page keeps its light and dark theme: it opts into the dark block of base.html.j2 and sets its own colour tokens.
The rules after "Reset" undo what the page stylesheet (page.css) sets on the same elements.
No page here draws a figure, so the Figura bundle is left out. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% block css %}
:root{--bg:#fbfbfa;--fg:#1b1d1f;--muted:#5d646b;--card:#ffffff;--line:#d9dcdf;--accent:#1f5fbf;
--ok:#16723a;--bad:#b3261e;--code:#f1f2f3}
@media (prefers-color-scheme:dark){:root{--bg:#14161a;--fg:#e6e8ea;--muted:#9aa3ab;--card:#1c1f24;--line:#33383f;
--accent:#7ab0ff;--ok:#5ccf86;--bad:#ff8a80;--code:#262a30}}
*{box-sizing:border-box}
body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font:15px/1.5 -apple-system,system-ui,"Segoe UI",sans-serif}
main{max-width:980px;margin:0 auto}
h1{font-size:1.25rem;margin:.2rem 0 .6rem;word-break:break-all}
h2{font-size:1rem;margin:1.4rem 0 .4rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
section{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin:10px 0}
pre{background:var(--code);padding:10px;border-radius:6px;overflow-x:auto;white-space:pre-wrap;word-break:break-word;
margin:.4rem 0;font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
table{border-collapse:collapse;width:100%}
th,td{border-bottom:1px solid var(--line);padding:4px 8px;text-align:left;vertical-align:top;font-size:14px}
th{color:var(--muted);font-weight:600}
a{color:var(--accent)}
.ok{color:var(--ok);font-weight:600}.bad{color:var(--bad);font-weight:600}.muted{color:var(--muted)}
.tag{display:inline-block;border:1px solid var(--line);border-radius:10px;padding:0 8px;margin:0 4px 4px 0;font-size:13px}
.table-wrap{overflow-x:auto}
th[data-col]{cursor:pointer}
@media (max-width:640px){body{padding:12px 16px}}
/* Reset */
body{max-width:none}
h1{line-height:inherit;color:inherit}
h2{padding-bottom:0;border-bottom:0}
table{border-top:0;border-bottom:0}
thead th{border-bottom:1px solid var(--line)}
pre{border-left:0}
code{background:none;padding:0;font-size:1em}
@media (max-width:480px){body{font-size:15px}th,td{padding:4px 8px}}
{% endblock %}
{% block content %}
<main>
{% block main %}{% endblock %}
</main>
{% endblock %}
{% block figura %}{% endblock %}
{% block motion %}{% endblock %}
