{#- The body of the run gallery, also a section of the full report. `c`: tsbench.report.gallery.context()[0].
`overview`: the accuracy chart of the current filter selection (the gallery page has it; the full report states the
accuracy once, in its first section). `table`: called with {% call %}, the caller's content becomes the first tab,
"Table" (the full report puts its run table there); the filters belong to the other tabs. The styles (gallery.css)
and the script (gallery.js) act inside `.gallery`. -#}
{% from "gallery_macros.html.j2" import options, run_card, image_card, code_card %}
{% macro gallery_body(c, overview=true, table=false) -%}
<div class="gallery">
{% if overview %}
<section id="overview-wrap"><h2>Accuracy of the selected runs per model and condition</h2><div id="overview"></div>
<p class="mut" id="overview-note"></p><p class="mut">All runs of the current selection, also from different run sets; the repetitions k1 to k3 of a task count one by one, and the Wilson interval treats them as independent.</p></section>
{% endif %}
<div class="tabs" role="tablist">{% if table %}<button data-pane="table" aria-selected="true">Table</button>
{% endif %}<button data-pane="runs" aria-selected="{{ 'false' if table else 'true' }}">{{ "Run cards" if table else "All runs" }}</button>
<button data-pane="images" aria-selected="false">Images</button>
<button data-pane="code" aria-selected="false">Code</button></div>
<div class="filters"><label>Model<select id="f-model">{{ options(c.models, "all") }}</select></label>
<label>Condition<select id="f-cond">{{ options(c.conds, "all") }}</select></label>
<label>Task class<select id="f-cls">{{ options(c.classes, "all") }}</select></label>
<label>Outcome<select id="f-ok"><option value="">all</option>{% for key, label in c.verdicts %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label>
<label>Search<input id="f-q" type="search" placeholder="model, task, code, flag ..."></label>
<span class="count" id="count" aria-live="polite"></span></div>
{% if table %}<section class="pane" id="table">{{ caller() }}</section>
{% endif %}<section class="pane runs" id="runs">
{% for t in c.run_tasks %}
<section class="task"><h3>{{ t.task }} <span class="mut">({{ t.cls }})</span></h3><div class="grid">{% for x in t.cards %}{{ run_card(x) }}{% endfor %}</div></section>
{% else %}
<p class="empty">No runs found.</p>
{% endfor %}
</section>
<section class="pane" id="images">
{% for t in c.image_tasks %}
<section class="task"><h3>{{ t.task }}</h3><div class="grid">{% for x in t.cards %}{{ image_card(x) }}{% endfor %}</div></section>
{% else %}
<p class="empty">No images found.</p>
{% endfor %}
</section>
<section class="pane" id="code">
{% for x in c.code_cards %}
{{ code_card(x) }}
{% else %}
<p class="empty">No code found.</p>
{% endfor %}
</section>
</div>
{%- endmacro %}
