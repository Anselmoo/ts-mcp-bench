{#- The dashboard page. Context: see tsbench.report.dashboard.context(), whole as `ctx`, and dashboard.design() as `design`;
the sections are the macros of dashboard_parts.html.j2 and the answer sheet of answer_parts.html.j2. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "answer_parts.html.j2" import answer_sheet %}
{% from "dashboard_parts.html.j2" import dash_by_task, dash_cost, dash_asked, dash_runs, dash_images, dash_provenance %}
{% block css %}body{max-width:1400px}
{% include "dashboard.css" %}
{% include "answer.css" %}{% endblock %}
{% block content %}
<header><h1>{{ title }}</h1>
<p class="stamp">{{ stamp }}</p>
{% if notes %}
<ul class="warn">{% for n in notes %}<li>{{ n }}</li>{% endfor %}</ul>
{% endif %}
</header>
{% if verdict %}
{{ answer_sheet(ctx, design, "Accuracy by condition") }}
{% endif %}
{{ dash_by_task(ctx) }}
{{ dash_cost(ctx) }}
{{ dash_asked(ctx) }}
{{ dash_runs(ctx) }}
{{ dash_images(ctx) }}
{{ dash_provenance(ctx) }}
{% endblock %}
{% block scripts %}
<script>{% include "dashboard.js" %}</script>
{% endblock %}
