{#- The index of the views of a run set. Context: title, split, head (column names), rows [[cell]] where a cell is
{text, sort, cls, href}, n_rows, plan_id, scores_sha. Clicking a column header sorts the table. -#}
{% extends "views_page.html.j2" %}
{% block main %}
<h1>Runs ({{ n_rows }}, {{ split }})</h1>
<p class="muted">Click a column header to sort. Every run_id opens its view.</p>
<div class="table-wrap"><table><thead><tr>
{% for h in head %}<th data-col="{{ loop.index0 }}">{{ h }}</th>{% endfor %}

</tr></thead><tbody>
{% for row in rows %}
<tr>{% for c in row %}<td data-sort="{{ c.sort }}"{% if c.cls %} class="{{ c.cls }}"{% endif %}>{% if c.href %}<a href="{{ c.href }}">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}</td>{% endfor %}</tr>
{% endfor %}
</tbody></table></div>
<p class="muted">plan_id: {{ plan_id or "none (no plan.jsonl in this directory)" }}<br>
scores.csv sha256: {{ scores_sha or "none" }}</p>
{% endblock %}
{% block scripts %}
<script>
document.querySelectorAll('th[data-col]').forEach(function(th){th.addEventListener('click',function(){
var t=th.closest('table'),b=t.tBodies[0],i=+th.dataset.col,asc=th.dataset.asc!=='1';th.dataset.asc=asc?'1':'0';
Array.from(b.rows).sort(function(x,y){var a=x.cells[i].dataset.sort,c=y.cells[i].dataset.sort,
n=parseFloat(a),m=parseFloat(c);var r=(!isNaN(n)&&!isNaN(m))?n-m:String(a).localeCompare(String(c));
return asc?r:-r;}).forEach(function(r){b.appendChild(r);});});});
</script>
{% endblock %}
