{#- The body of the coverage page, also a section of the full report. `c`: tsbench.report.coverage.context();
`h`: the heading level of its sections (h2 on the page, h3 inside the full report). -#}
{% macro coverage_body(c, h="h2") -%}
<p class="lede">{{ c.summary }}</p>
<p class="muted">Target: {{ c.k }} evaluable runs per pilot task × model × condition (effort {{ c.effort }}); {{ c.n_tasks }} tasks, {{ c.n_cells }} cells. Generated {{ c.stamp }}.</p>
<{{ h }}>Evaluable runs per task class against the target</{{ h }}>
<div class="scroll plate"><table class="cov">
<thead><tr><th rowspan="2">Class</th>{% for m in c.models %}<th colspan="{{ c.conds | length }}">{{ m }}</th>{% endfor %}</tr>
<tr>{% for m in c.models %}{% for x in c.conds %}<th>{{ x }}</th>{% endfor %}{% endfor %}</tr></thead>
<tbody>
{% for row in c.rows %}
<tr><th>{{ row.class }}</th>{% for x in row.cells %}<td class="num hm{{ ' hd' if x.dark }}" style="--p:{{ x.p }}" title="{{ x.have }} of {{ x.want }} runs; {{ x.full }} of {{ x.n }} tasks with ≥ {{ c.k }}">{{ x.have }}/{{ x.want }}<small>{{ x.full }}/{{ x.n }} tasks ≥ {{ c.k }}</small></td>{% endfor %}</tr>
{% endfor %}
</tbody></table></div>
<{{ h }}>Cells without an evaluable run</{{ h }}>
{% if c.zeros %}
<p>{% for m, n in c.per_model %}{% if not loop.first %}, {% endif %}{{ m }} {{ n }}{% endfor %}</p>
<div class="scroll"><table><thead><tr><th>Model</th><th>Cond.</th><th>Task</th><th>Class</th><th>Reason</th></tr></thead><tbody>
{% for z in c.zeros %}
<tr><td>{{ z.model }}</td><td>{{ z.cond }}</td><td>{{ z.task }}</td><td>{{ z.class }}</td><td>{{ z.why }}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}
<p>None: every cell has at least one evaluable run.</p>
{% endif %}
<p class="muted">Evaluable: no HTTP 429, no API error; a run without a result (time limit) counts as evaluable and wrong. Run sets skipped (made with another task set): {{ c.skipped | length }}{% if c.skipped %} ({{ c.skipped | join(", ") }}){% endif %}.</p>
{%- endmacro %}
