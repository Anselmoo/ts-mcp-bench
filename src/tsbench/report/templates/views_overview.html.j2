{#- The overview of all run sets. Context: title, rows [{name, href (or none), title, n_views}]. -#}
{% extends "views_page.html.j2" %}
{% block main %}
<h1>Run sets</h1><p class="muted">Every run set links the index of its per-run views.</p>
<div class="table-wrap"><table><thead><tr><th>run set</th><th>title</th><th>views</th></tr></thead><tbody>
{% for r in rows %}
<tr><td>{% if r.href %}<a href="{{ r.href }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</td><td>{{ r.title }}</td><td>{{ r.n_views }}</td></tr>
{% endfor %}
</tbody></table></div>
{% endblock %}
