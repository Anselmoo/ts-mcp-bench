{#- The frame of every report page: charset, the Content-Security-Policy, the page stylesheet once, then the page.

Context: `title` (required). A page opts into dark colours with `{% set dark = true %}`; the dark tokens apply on
screen only, so a printed page stays light. The figures and the colour-coded tables (class `plate`) sit on the card
colour (`--card`): light, and dark on a dark screen, where runtime.js draws the figures in its dark theme too.
A page with a light/dark switch sets `{% set theme_switch = true %}`: the same dark tokens then apply under the
selectors of the switch (system dark unless set to light, and set to dark).
Blocks a page fills: `css` (its own rules, inside the one <style>), `content` (the body), `scripts` (its own complete
<script> elements). `figura` holds d3, the Figura bundle and the drawing runtime; a page without figures empties it.
`motion` holds motion.js (window.TSMOTION, before `figura`): staged figure marks, legend emphasis; a page
without scripts empties it with `figura`.
-#}
{% set dark = dark is defined and dark %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{{ csp_meta }}
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="{{ 'light dark' if dark else 'light' }}">
<title>{{ title }}</title>
<style>
{% include "page.css" %}
{% block dark %}
{% if dark %}
{% set tokens %}--paper:#161a20;--ink:#e6e8ea;--ink-muted:#a7b0b9;--rule:#6b737c;--grid:#2c323a;--tint:#1d2533;--deep:#dce6f8;
--primary:#7ab0ff;--signal:#8ab8ff;--s1:#7ab0ff;--s2:#e0b04a;--s3:#f07fae;--s4:#6cc0f0;--s5:#5ccf86;--s6:#ff8a80;
--grid-minor:#22272e;--surface:#0e1116;--card:#161a20;--line:#2c323a;--hover:#1d2533;--hatch:#3a4a66;--ok:#6fd99a;
--ok-bg:#5ccf862e;--bad:#ff9a90;--bad-bg:#ff8a802e;--warn:#eec46a;--warn-bg:#e0b04a2e;color-scheme:dark{% endset %}
{% if theme_switch is defined and theme_switch %}
:root[data-theme=light]{color-scheme:light}
@media screen and (prefers-color-scheme:dark){:root:not([data-theme=light]){ {{- tokens -}} }}
@media screen{:root[data-theme=dark]{ {{- tokens -}} }}
{% else %}
@media screen and (prefers-color-scheme:dark){:root{ {{- tokens -}} }}
{% endif %}
{% endif %}
{% endblock %}
{% block css %}{% endblock %}
</style>
</head>
<body>
<main id="main">
{% block content %}{% endblock %}
</main>
{% block motion %}<script id="tsb-motion">{% include "motion.js" %}</script>{% endblock %}
{% block figura %}
<script id="jfs-lib">{{ figura_js() }}</script>
<script id="fig-draw">{% include "runtime.js" %}</script>
{% endblock %}
{% block scripts %}{% endblock %}
</body>
</html>
