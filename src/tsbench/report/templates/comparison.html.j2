{#- The comparison page of the conditions A, B and C. Context: see tsbench.report.comparison.context(); the sections are
the macros of comparison_parts.html.j2. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "comparison_parts.html.j2" import section_header, section_summary, section_rules, section_verdict, section_heatmap, section_costs, section_reasons, section_not_evaluable, section_method %}
{% block css %}
{% include "comparison.css" %}
{% endblock %}
{% block content %}
{{ section_header(header) }}
{{ section_summary(sentences) }}
{{ section_verdict(verdict) }}
{{ section_heatmap(heatmap) }}
{{ section_costs(costs) }}
{% if reasons %}
{{ section_reasons(reasons) }}
{% endif %}
{{ section_not_evaluable(not_evaluable) }}
{{ section_rules(rules) }}
{{ section_method() }}
{% endblock %}
