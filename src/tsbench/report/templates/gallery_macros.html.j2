{#- The parts of the run gallery. Import them with {% from "gallery_macros.html.j2" import run_card, image_card, code_card %}.
A card is a dict made by tsbench.report.gallery; every value is escaped by the environment. -#}

{#- The <option> list of a filter: the first entry stands for "no filter". -#}
{% macro options(values, all_label) -%}
<option value="">{{ all_label }}</option>
{%- for v in values -%}
<option value="{{ v }}">{{ v }}</option>
{%- endfor -%}
{%- endmacro %}

{#- The data attributes the filters of the page read. -#}
{% macro data_attrs(a) -%}
data-model="{{ a.model }}" data-cond="{{ a.cond }}" data-cls="{{ a.cls }}" data-ok="{{ a.ok }}" data-s="{{ a.s }}"
{%- endmacro %}

{#- Icon and text of a verdict. -#}
{% macro badge(h) -%}
<span class="badge {{ h.verdict }}"><span aria-hidden="true">{{ h.icon }}</span> {{ h.label_text }}</span>
{%- endmacro %}

{#- The head of every card: outcome and condition first, so they stand at the same place on every card; then model,
effort, gateway and repetition; then task and run set. -#}
{% macro head(h) -%}
<div class="meta top">{{ badge(h) }} <b>condition {{ h.cond }}</b>{% for f in h.flags %} <span class="flagtag">{{ f }}</span>{% endfor %}</div>
<div class="meta"><b>{{ h.model }}</b> &middot; {{ h.effort }} &middot; {{ h.gateway }} &middot; k{{ h.k }}</div>
<div class="meta">{{ h.task }} ({{ h.cls }}) &middot; run set {{ h.label }}{% if h.view %} &middot; <a href="{{ h.view }}">run view</a>{% endif %}</div>
{%- endmacro %}

{#- The copyable reproduce block; nothing when the commands could not be made. -#}
{% macro repro(text) -%}
{% if text is not none %}<div class="repro"><div class="repro-h"><span>Reproduce</span><button type="button" class="copy" aria-label="Copy the commands">Copy</button></div><pre>{{ text }}</pre></div>{% endif %}
{%- endmacro %}

{#- Text with an optional colour class: {"text", "cls"}. -#}
{% macro tone(item) -%}
{% if item.cls %}<span class="{{ item.cls }}">{{ item.text }}</span>{% else %}{{ item.text }}{% endif %}
{%- endmacro %}

{% macro run_card(c) -%}
<article class="item run" {{ data_attrs(c.attrs) }}>{{ head(c.head) }}
{%- if c.why %}<div class="why">Reason: {{ c.why }}</div>{% endif %}
{%- if c.figs %}<div class="figs">
{%- for f in c.figs %}<figure>
{%- if f.src %}<img id="{{ f.ident }}" src="{{ f.src }}" alt="{{ f.alt }}" loading="lazy">
{%- elif f.clone %}<div class="clone" data-from="{{ f.clone }}" role="img" aria-label="{{ f.alt }}"></div>
{%- elif f.link %}<p class="empty">Not embedded (page size limit): <a href="{{ f.link }}">open the figure file</a>.</p>
{%- else %}<p class="empty">Figure too large to embed.</p>{% endif %}<figcaption>{{ f.title }}</figcaption></figure>{% endfor %}</div>{% endif %}
{%- if c.img_ids %}<div class="clone" data-from="{{ c.img_ids }}">{% for i in c.img_ids.split(" ") %}<a class="dflt" href="#{{ i }}">image {{ loop.index }}</a> {% endfor %}</div>{% endif %}
{%- if c.code_id %}<details><summary>Code of the run ({{ c.n_code }} entries)</summary><div class="clone" data-from="{{ c.code_id }}"><a class="dflt" href="#{{ c.code_id }}">code of the run</a></div></details>{% endif %}
{{- repro(c.repro) }}</article>
{%- endmacro %}

{% macro image_card(c) -%}
<article class="item" {{ data_attrs(c.attrs) }}>
{%- if c.src %}<img{% if c.ident %} id="{{ c.ident }}"{% endif %} src="{{ c.src }}" alt="{{ c.alt }}" loading="lazy">
{%- elif c.link %}<p class="empty"{% if c.ident %} id="{{ c.ident }}"{% endif %}>Not embedded (page size limit): <a href="{{ c.link }}">open the image file</a>.</p>
{%- else %}<p class="empty"{% if c.ident %} id="{{ c.ident }}"{% endif %}>Image too large to embed.</p>{% endif %}
{{- head(c.head) }}<div class="meta">source: <b>{{ c.source }}</b> &middot; {{ c.name }} &middot; {{ c.kb }} KB{% if c.linked %} &middot; linked, not embedded{% endif %}</div><div class="meta">{{ tone(c.sha) }}</div>
{{- repro(c.repro) }}</article>
{%- endmacro %}

{% macro code_block(b) -%}
<details{% if b.open %} open{% endif %}><summary><b>{{ b.label }}</b> &middot; {{ tone(b.status) }} &middot; {{ b.lines }} lines</summary><pre>{{ b.body }}</pre>
{%- if b.capped %}<div class="meta">... shortened, full file: {{ b.rel }}</div>{% endif %}
{%- if b.excerpt %}<pre class="res">{{ b.excerpt }}</pre>{% endif %}</details>
{%- endmacro %}

{% macro code_card(c) -%}
<article class="item run" {{ data_attrs(c.attrs) }}>{{ head(c.head) }}<div{% if c.ident %} id="{{ c.ident }}"{% endif %}><div class="meta">{{ c.n_files }} Bash/heredoc files, {{ c.n_mcp }} MCP calls</div>
{%- for b in c.blocks %}{{ code_block(b) }}{% endfor %}
{%- if c.more %}<div class="meta">... {{ c.more }} more entries not shown.</div>{% endif %}</div>
{{- repro(c.repro) }}</article>
{%- endmacro %}
