{#- Parts of the dashboard page (templates/dashboard.html.j2). Each macro takes a dict that
tsbench.report.dashboard.context() built. -#}
{% from "_macros.html.j2" import fig, status_chip %}

{#- A status with icon and text: {"icon", "text"}. -#}
{% macro st(item) -%}
<span class="st">{{ icon(item.icon, "ink") }}{{ item.text }}</span>
{%- endmacro %}

{#- The figure of one model (share correct with interval, stacked outcome bars). The figure carries the numbers; the
same numbers as text stand in its <noscript> and, collapsed, below it. -#}
{% macro rate_figure(r) -%}
{% set text %}
<ul class="cdlist">
{% for it in r["items"] %}
<li data-cond="{{ it.cond }}"><b>{{ it.name }}</b>: {{ it.core }}<br>{% for c in it.chips %}<span class="cd">{{ status_chip(c.key, c.text) }}</span>{% endfor %}</li>
{% endfor %}
</ul>
{% endset %}
{{ fig("rate", r.spec, r.title, r.alt, text) }}<details class="numtext"><summary>The numbers as text</summary>{{ text }}</details>
{%- endmacro %}

{#- TS-MCP against each other condition task by task (figure kind "pairs"); the counts as text below it. -#}
{% macro pairs_figure(p) -%}
{% set text %}<ul class="pairtext">{% for t in p.text %}<li>{{ t }}</li>{% endfor %}</ul>{% endset %}
{{ fig("pairs", p.spec, p.title, p.alt, text) }}{{ text }}
{%- endmacro %}

{#- A dot plot with its table in the <noscript> and its legend. -#}
{% macro dots_chart(c) -%}
{% set table %}
<div class="scroll"><table class="small"><thead><tr><th>Model</th>{% for k in c.series %}<th>{{ k }}</th>{% endfor %}</tr></thead><tbody>
{% for row in c.table %}
<tr><td>{{ row.label }}</td>{% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}
</tbody></table></div>
{% endset %}
{{ fig("dots", c.spec, c.title, c.alt, table) }}
{%- endmacro %}

{#- The one legend of the dot charts: [{name, color, shape}], the marker as the figures draw it. The colour of A, B and C
is the page's token (--s1 to --s3), so the legend follows the dark scheme as the figures do. -#}
{% macro cond_legend(items) -%}
<div class="legend">{% for l in items %}{% set fill = {"A": "var(--s1)", "B": "var(--s2)", "C": "var(--s3)"}.get(l.cond, l.color) %}<span class="lg"><svg class="mk" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
{%- if l.shape == "circle" %}<circle cx="5" cy="5" r="4" fill="{{ l.color }}" style="fill:{{ fill }}"/>
{%- elif l.shape == "square" %}<rect x="1.5" y="1.5" width="7" height="7" fill="{{ l.color }}" style="fill:{{ fill }}"/>
{%- elif l.shape == "triangle" %}<path d="M5 1L9.3 8.7H.7z" fill="{{ l.color }}" style="fill:{{ fill }}"/>
{%- else %}<path d="M5 .5L9.5 5L5 9.5L.5 5z" fill="{{ l.color }}" style="fill:{{ fill }}"/>{% endif %}</svg>{{ l.name }}</span>{% endfor %}</div>
{%- endmacro %}

{#- A table cell with a number: {"text", "v"}; `v` is what the column sorts by. -#}
{% macro num(c) -%}
<td{% if c.v is not none %} data-v="{{ c.v }}"{% endif %}>{{ c.text }}</td>
{%- endmacro %}
