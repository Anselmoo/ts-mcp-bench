{#- Parts of the literature page. Import them with {% from "literature_macros.html.j2" import doi_text, ... %}.
Every value is escaped by the environment. A cell is a dict: {"empty": true}, or {"text", "muted"}, or, for a value
checked against the tolerance, {"text", "ok", "tol"} with `tol` the tolerance in percent. -#}
{% from "_macros.html.j2" import status_chip %}

{#- The source text of the literature table; a DOI is a link (parts: see literature._doi_parts). -#}
{% macro doi_text(parts) -%}
{%- for p in parts -%}
{%- if p.href -%}<a href="{{ p.href }}" rel="noopener">{{ p.text }}</a>{%- else -%}{{ p.text }}{%- endif -%}
{%- endfor -%}
{%- endmacro %}

{#- One table cell: empty, a number, a dash or a value with the icon and the word for within or outside. -#}
{% macro cell(c) -%}
{% if c.get("empty") %}<td></td>
{%- elif c.get("ok") is none %}<td class="num{{ ' muted' if c.get('muted') }}">{{ c.text }}</td>
{%- else %}{% set word = "within" if c.ok else "outside" %}<td class="num"><span class="st" title="{{ word }} the tolerance ±{{ c.tol }} %">
{{- icon("check", "ok") if c.ok else icon("cross", "bad") }}{{ c.text }}<span class="sr"> ({{ word }})</span></span></td>
{%- endif %}
{%- endmacro %}

{#- One run of a model: the columns before the values, the cells, the links and the reproduce block. -#}
{% macro run_row(r) -%}
<tr class="{{ r.cls }}"><td>{{ r.model }}</td><td>{{ r.cond }}</td><td>{{ r.effort }}</td><td class="num">{{ r.k }}</td>
<td>{{ status_chip(r.outcome) }}{% if r.rescued %} <span class="muted">(rescued)</span>{% endif %}</td>
{%- for c in r.cells %}{{ cell(c) }}{% endfor %}
<td>{% if r.transcript %}<a href="{{ r.transcript }}">transcript</a>{% endif %}
{%- if r.transcript and r.view %} · {% endif %}
{%- if r.view %}<a href="{{ r.view }}">view</a>{% endif %}
<details class="rep"><summary>Reproduce</summary><pre>{{ r.cmd }}</pre></details></td></tr>
{%- endmacro %}

{#- A reference row (paper, oracle, tolerance): the label over five columns, then the cells. -#}
{% macro ref_row(r) -%}
<tr class="{{ r.cls }}"><td colspan="5"><b>{{ r.bold }}</b>{% if r.rest %} {{ r.rest }}{% endif %}</td>
{%- for c in r.cells %}{{ cell(c) }}{% endfor %}</tr>
{%- endmacro %}

{#- The band energies of a system with their terms. -#}
{% macro bands_table(rows, unit) -%}
<table class="small bands"><thead><tr><th>Term</th><th>Band ({{ unit }})</th></tr></thead><tbody>
{%- for b in rows %}<tr><td>{{ b.label }}</td><td class="num">{{ b.band }}</td></tr>{% endfor -%}
</tbody></table>
{%- endmacro %}

{#- The text of the points of a figure, for a reader without scripts. -#}
{% macro tip_table(tips) -%}
<table class="small"><tbody>{% for t in tips %}<tr><td>{{ t }}</td></tr>{% endfor %}</tbody></table>
{%- endmacro %}

{#- Share correct per model and condition, as the table beside the dot chart. -#}
{% macro rate_table(rows) -%}
<div class="scroll"><table class="small"><thead><tr><th>Model · condition</th><th>correct</th><th>share</th>
<th>95 % interval</th><th>harness limit</th><th>429</th></tr></thead><tbody>
{%- for r in rows %}
<tr><td>{{ r.label }}</td><td class="num">{{ r.correct }} of {{ r.n_eval }}</td><td class="num">{{ r.share }}</td><td class="num">{{ r.ci }}</td>
<td class="num">{{ r.harness }}</td><td class="num">{{ r.na429 }}</td></tr>
{%- endfor %}
</tbody></table></div>
{%- endmacro %}

{#- The key of the marks in the parity and dot plots. -#}
{% macro cond_legend(items) -%}
<div class="legend" role="list">
{%- for c in items -%}
<span class="lg" role="listitem"><b>{{ c.cond }}</b> · {{ c.name }} ({{ c.shape }})</span>
{%- endfor -%}
<span class="lg" role="listitem">paper (cross)</span><span class="lg" role="listitem">band = tolerance around the oracle</span></div>
{%- endmacro %}
