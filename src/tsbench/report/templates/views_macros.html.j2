{#- Parts of the views pages. Import them with {% from "views_macros.html.j2" import pre, images %}. Every value is
escaped by the environment; the text of a transcript is data, never markup. -#}

{#- A block of preformatted text; the caller has already cut it to length. -#}
{% macro pre(text) -%}
<pre>{{ text }}</pre>
{%- endmacro %}

{#- Figures for the images the runner harvested: [{name, sha256, sha_ok, uri}]. `match` says whether the image sha256
reported by the model matches a harvested file (none: say nothing). -#}
{% macro images(items, match=none, max_width=480) -%}
{%- for im in items -%}
{%- if im.uri -%}
<figure><img alt="{{ im.name }}" src="{{ im.uri }}" style="max-width:min(100%,{{ max_width }}px)">
{#- #}<figcaption class="muted">{{ im.name }} &middot; sha256 {{ (im.sha256 | string)[:12] }}
{%- if not im.sha_ok %} <span class="bad">sha256 differs from the record</span>{% endif %}</figcaption></figure>
{%- else -%}
<p class="muted">{{ im.name }}: not embedded</p>
{%- endif -%}
{%- endfor -%}
{%- if items and match is not none -%}
<p class="{{ 'ok' if match else 'bad' }}">image sha256 reported by the model {{ 'matches' if match else 'does not match' }} a harvested file</p>
{%- endif -%}
{%- endmacro %}
