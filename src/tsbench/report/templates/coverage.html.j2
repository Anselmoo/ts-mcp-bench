{#- The coverage page. Context: see tsbench.report.coverage.context(), whole as `ctx`; the body is the macro of
coverage_parts.html.j2, which the full report uses too. -#}
{% extends "base.html.j2" %}
{% set dark = true %}
{% from "coverage_parts.html.j2" import coverage_body %}
{% block css %}{% include "coverage.css" %}{% endblock %}
{% block content %}
<h1>{{ title }}</h1>
{{ coverage_body(ctx, "h2") }}
{% endblock %}
{#- The page has no figures: the d3 and Figura bundles are left out. -#}
{% block figura %}{% endblock %}
{% block motion %}{% endblock %}
