{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src/tsbench/data/schemas/plan.schema.json",
  "title": "Benchmark run plan, one JSON object per line (header first, then runs)",
  "oneOf": [{"$ref": "#/$defs/header"}, {"$ref": "#/$defs/run"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "plan_id", "created_utc", "spec", "tasks_sha256",
                   "generator_git_commit", "pins", "sealed", "n_runs", "budget_usd_total", "counts"],
      "properties": {
        "kind": {"const": "header"},
        "schema_version": {"enum": [2, 3, 4]},
        "plan_id": {"$ref": "#/$defs/sha256"},
        "created_utc": {"type": "string", "minLength": 1},
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["split", "models", "conditions", "efforts", "k", "budget_usd", "limit",
                       "system_prompt_file", "gateway"],
          "properties": {
            "split": {"enum": ["pilot", "confirmatory"]},
            "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "conditions": {"type": "array", "minItems": 1, "items": {"enum": ["A", "B", "C"]}},
            "efforts": {"type": "array", "minItems": 1,
                        "items": {"enum": ["low", "medium", "high", "xhigh", "max"]}},
            "k": {"type": "integer", "minimum": 1},
            "k_from": {"type": "integer", "minimum": 1},
            "stage": {"type": "string", "minLength": 1},
            "budget_usd": {"type": "number", "minimum": 0},
            "limit": {"type": ["integer", "null"]},
            "system_prompt_file": {"type": "string", "minLength": 1},
            "gateway": {"type": "boolean"}
          }
        },
        "tasks_sha256": {"type": ["string", "null"]},
        "generator_git_commit": {"type": ["string", "null"]},
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude_cli_version", "tanabesugano", "python", "sandbox_settings_sha256",
                       "ts_json_sha256", "answer_schema_sha256"],
          "properties": {
            "claude_cli_version": {"type": ["string", "null"]},
            "b_stack_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "tanabesugano": {"type": "string"},
            "python": {"type": "string"},
            "sandbox_settings_sha256": {"$ref": "#/$defs/sha256"},
            "sandbox_probe_script_sha256": {"$ref": "#/$defs/sha256"},
            "ts_json_sha256": {"$ref": "#/$defs/sha256"},
            "conditions_py_sha256": {"$ref": "#/$defs/sha256"},
            "answer_schema_sha256": {"$ref": "#/$defs/sha256"},
            "answer_schemas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
          }
        },
        "sealed": {"type": "boolean"},
        "n_runs": {"type": "integer", "minimum": 1},
        "budget_usd_total": {"type": "number", "minimum": 0},
        "per_call_cap": {"type": ["number", "null"]},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by_condition", "by_class", "by_model", "by_effort"],
          "properties": {
            "by_condition": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "by_model": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "by_effort": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "task_id", "task_class", "split", "task_sha256", "prompt", "prompt_sha256",
                   "system_prompt_file", "system_prompt_sha256", "system_prompt_text", "model", "effort",
                   "condition", "k", "max_turns", "tools_expected", "argv_template", "expected_flags",
                   "answer_format"],
      "properties": {
        "kind": {"const": "run"},
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "task_class": {"type": "string", "minLength": 1},
        "split": {"enum": ["pilot", "confirmatory"]},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "prompt": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "system_prompt_file": {"type": "string", "minLength": 1},
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "system_prompt_text": {"type": "string"},
        "model": {"type": "string", "minLength": 1},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "condition": {"enum": ["A", "B", "C"]},
        "k": {"type": "integer", "minimum": 1},
        "max_turns": {"type": "integer", "minimum": 1},
        "tools_expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcp_servers"],
          "properties": {
            "tools": {"type": "array", "items": {"type": "string"}},
            "mcp_prefix": {"type": "string"},
            "mcp_servers": {"type": "array", "items": {"type": "string"}}
          }
        },
        "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_flags": {"type": "array", "items": {"type": "string"}},
        "disallowed_tools": {"type": "array", "items": {"type": "string"}},
        "answer_schema": {"enum": ["fit", "curve", "batch", "pairing", "diagram"]},
        "answer_schema_sha256": {"$ref": "#/$defs/sha256"},
        "b_stack_sha256": {"$ref": "#/$defs/sha256"},
        "answer_format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "enforced", "schema_sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "enforced": {"const": "json-schema"},
            "schema_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fn"],
          "properties": {
            "kind": {"enum": ["closed_form", "forward_model", "compute_fn"]},
            "fn": {"type": "string"},
            "args": {"type": "object"}
          }
        }
      }
    }
  }
}
