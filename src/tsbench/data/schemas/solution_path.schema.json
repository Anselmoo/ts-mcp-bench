{
  "$comment": "Solution path of one transcript (tsbench.score.solution_path): which code ran, in which order, what it printed, and which step printed each number of the answer. Derived from the transcript only; the model reports nothing extra. Not an answer schema: it never reaches --json-schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "transcript", "transcript_sha256", "answer", "steps", "values", "summary"],
  "properties": {
    "format": {"const": "tsbench.solution_path/1"},
    "transcript": {"type": "string", "minLength": 1},
    "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer": {"type": ["object", "null"]},
    "steps": {"type": "array", "items": {"$ref": "#/definitions/step"}},
    "values": {"type": "array", "items": {"$ref": "#/definitions/value"}},
    "summary": {"$ref": "#/definitions/summary"}
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tool", "description", "command", "scripts", "runs", "edits_in_place", "exit", "is_error",
                   "stdout", "stdout_truncated", "methods", "key_lines", "produces"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "tool": {"type": "string"},
        "description": {"type": "string"},
        "command": {"type": "string"},
        "scripts": {"type": "array", "items": {"$ref": "#/definitions/script"}},
        "runs": {"type": "array", "items": {"$ref": "#/definitions/run"}},
        "edits_in_place": {"type": "boolean"},
        "exit": {"type": ["integer", "null"]},
        "is_error": {"type": "boolean"},
        "stdout": {"type": "string"},
        "stdout_truncated": {"type": "boolean"},
        "methods": {"type": "array", "items": {"enum": ["eigen_solver", "least_squares", "interpolation", "typed_table",
                                                         "plot", "hash"]}},
        "key_lines": {"type": "array", "items": {"$ref": "#/definitions/key_line"}},
        "produces": {"type": "array", "items": {"type": "string"}}
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "lines", "code"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lines": {"type": "integer", "minimum": 0},
        "code": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "written_in_step"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "written_in_step": {"type": ["integer", "null"]}
      }
    },
    "key_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "line", "method", "text"],
      "properties": {
        "script": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "method": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "weak", "steps", "typed_in_steps", "source_step"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "weak": {"type": "boolean"},
        "steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "typed_in_steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "source_step": {"type": ["integer", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_steps", "n_scripts", "n_failed_steps", "n_values", "n_linked", "n_weak", "source_steps",
                   "methods", "edits_in_place"],
      "properties": {
        "n_steps": {"type": "integer", "minimum": 0},
        "n_scripts": {"type": "integer", "minimum": 0},
        "n_failed_steps": {"type": "integer", "minimum": 0},
        "n_values": {"type": "integer", "minimum": 0},
        "n_linked": {"type": "integer", "minimum": 0},
        "n_weak": {"type": "integer", "minimum": 0},
        "source_steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "methods": {"type": "array", "items": {"type": "string"}},
        "edits_in_place": {"type": "boolean"}
      }
    }
  }
}
