continue\n            H2[idx[r[1]],I]+=0.5*r[0]*CK[(2,a,c)]*CK[(2,d,b)]\n            H4[idx[r[1]],I]+=0.5*r[0]*CK[(4,a,c)]*CK[(4,d,b)]\n    return Hdq,H2,H4\nb0=blocks(3); b1=blocks(4)\ndef levels(Dq,B,C):\n    F4=C*441/35; F2=49*(B+5*F4/441)\n    out=[]\n    for bl in (b0,b1):\n        H=Dq*bl[0]+F2*bl[1]+F4*bl[2]\n        out.append(np.round(np.linalg.eigvalsh(H),4))\n    e0,e1=out\n    # remove Ms=1 levels from Ms=0 list\n    l0=list(e0)\n    for x in e1:\n        j=np.argmin(np.abs(np.array(l0)-x)); l0.pop(j)\n    l0=np.array(sorted(l0))\n    # group degeneracies\n    g=[]\n    for x in l0:\n        if g and abs(g[-1][0]-x)<1e-2: g[-1][1]+=1\n        else: g.append([x,1])\n    E0=min(e0.min(),e1.min())\n    return [(round(x-g[0][0],1),d) for x,d in g], round(g[0][0]-E0,1)\ndef bands(Dq,B):\n    g,_=levels(Dq,B,4.5*B)\n    return g\nprint(levels(1643,548.75,2469)[0][:8])\nobs=np.array([13960,22740,29700])\ndef res(p):\n    g=bands(*p); e=[x for x,d in g if d==3][:3]\n    return np.array(e)-obs\ns=least_squares(res,[1643,550],diff_step=1e-3); print(s.x,res(s.x))\nprint(bands(*s.x)[:8])\nEOF\npython3 d6.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2204,"cache_read_input_tokens":1691,"cache_creation":{"ephemeral_5m_input_tokens":2204,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"59b5cf6f-962e-42ab-a0dd-a9ce6c2fb869","uuid":"559a92d3-0ca0-48fe-a322-881340b952d5","timestamp":"2026-11-03T11:39:57.779Z","request_id":"req_011CgfvwCGpfDUs1K3tMZSMn"}
