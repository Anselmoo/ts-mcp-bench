h=U@np.diag([6*Dq,6*Dq,-4*Dq,-4*Dq,-4*Dq])@U.conj().T\n    H=np.zeros((n,n),complex)\n    for d in dets:\n        j=di[d]\n        for p in range(N):\n          for q in range(N):\n            if so(p)!=so(q):continue\n            v=h[ix(mo(p)),ix(mo(q))]\n            if abs(v)<1e-12:continue\n            r=seq(d,[('a',q),('c',p)])\n            if r:H[di[r[0]],j]+=v*r[1]\n    for p in range(N):\n     for q in range(N):\n      for r_ in range(N):\n       for s_ in range(N):\n        if so(p)!=so(r_) or so(q)!=so(s_) or mo(p)+mo(q)!=mo(r_)+mo(s_):continue\n        v=sum(F[k]*C2[(k,mo(p),mo(r_))]*C2[(k,mo(s_),mo(q))] for k in(2,4))\n        if abs(v)<1e-12:continue\n        for d in dets:\n            r=seq(d,[('a',r_),('a',s_),('c',q),('c',p)])\n            if r:H[di[r[0]],di[d]]+=0.5*v*r[1]\n    return H\ndef levels(Dq,B,C_):\n    H=Hmat(Dq,B,C_)\n    w,v=np.linalg.eigh((H+H.conj().T)/2)\n    s2=np.real(np.einsum('ij,ik,kj->j',v.conj(),S2,v))\n    sing=w[abs(s2)<1e-6]\n    sing=np.round(sing-sing.min(),3)\n    # group degeneracies\n    out=[];\n    for e in sing:\n        if out and abs(out[-1][0]-e)<0.5:out[-1][1]+=1\n        else:out.append([e,1])\n    return out\nprint(levels(2000,600,2400)[:8])\ntri=lambda x:[e for e,dg in levels(x[0],x[1],4*x[1]) if dg==3][:3]\nobs=np.array([16700,26330,35020])\nfor g in [(2000,500),(2500,600),(1800,400)]:\n    r=least_squares(lambda x:np.array(tri(x))-obs,g,diff_step=1e-4)\n    print(r.x,r.fun)\nE"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":450,"cache_read_input_tokens":4474,"cache_creation":{"ephemeral_5m_input_tokens":450,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bdefe1e3-7243-43a0-867f-f80b093c610a","uuid":"f98e998b-09d